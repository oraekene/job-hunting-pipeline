# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest-cache/
.ruff_cache/
.mypy_cache/
.ty_cache/

# Local merge tracking
.merge-history/

# Runtime data / secrets shaped files unless intentionally tracked
*.db
*.sqlite
*.sqlite3
*.env
.env*
*.pem
*.key

# Tier 1 personal memory bank — local only, never staged or pushed
memory/

# Local scratch files are ignored, while the tracked issue-tracker folders
# stay visible. Audit dumps and dated personal packet folders stay local.
.scratch/*
!.scratch/*/
.scratch/audit/
.scratch/nous-*/

# Runtime state and generated application data (regenerable, personal)
shared/build_artifacts/
shared/.outbox/
shared/company_research_cache/
shared/.scripts/
shared/.discovery_gate_state.json
shared/applications.db*

# Session logs and chat exports
hermes agent log file*.txt
run-full-job*.json
request_dump_*.json

# Stray debugging SQL left in the bundle root
query_*.sql
schema_query.sql

# Stray root-level debug folders
.outbox/

# Windows reserved device name: an earlier shell redirect created it and
# the OS resolves "NUL" to the null device, so it cannot be removed
# normally. Untracked, but ignore it so "git add -A" never picks it up.
/NUL

# Stray generated resume at repo root (regenerable, personal)
tailored_resume.docx

# Cron-registration audit trail (machine-local, regenerated)
cron/registered-jobs.json

# Runtime discovery/submit-gate state (regenerable, per-run)
shared/.active_application/
shared/.discovery_results.json

# Control plane GUI: inventory dumps and config backups stay machine-local
.scratch/control-plane/
control-plane/backups/

# Local archives contain private memory or duplicate the repo; keep them off the public remote
/job-hunting.zip
/shared.zip
/14-social-discovery-outreach.zip

